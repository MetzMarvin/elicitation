    <bpmn2:textAnnotation id="TextAnnotation_0krxina" name="Email the person a link to a google form. When the form is submitted, it calls a Google Cloud Function and a row will be entered into a google sheet.">
      <bpmn2:extensionElements>
        <drools:metaData name="elementname">
          <drools:metaValue><![CDATA[Email the person a link to a google form. When the form is submitted, it calls a Google Cloud Function and a row will be entered into a google sheet.]]></drools:metaValue>
        </drools:metaData>
      </bpmn2:extensionElements>
      <bpmn2:text>Email the person a link to a google form. When the form is submitted, it calls a Google Cloud Function and a row will be entered into a google sheet.</bpmn2:text>
    </bpmn2:textAnnotation>
    <bpmn2:textAnnotation id="TextAnnotation_1458xg3" name="When the Google Form is submitted, it calls a Google Cloud function which uses the Zeebe GRPC API to publish a message to allow the process to continue">
      <bpmn2:extensionElements>
        <drools:metaData name="elementname">
          <drools:metaValue><![CDATA[When the Google Form is submitted, it calls a Google Cloud function which uses the Zeebe GRPC API to publish a message to allow the process to continue]]></drools:metaValue>
        </drools:metaData>
      </bpmn2:extensionElements>
      <bpmn2:text>When the Google Form is submitted, it calls a Google Cloud function which uses the Zeebe GRPC API to publish a message to allow the process to continue</bpmn2:text>
    </bpmn2:textAnnotation>
    <bpmn2:textAnnotation id="TextAnnotation_0mx75ie" name="Ask OpenAI whether this song is appropriate for the type of event">
      <bpmn2:extensionElements>
        <drools:metaData name="elementname">
          <drools:metaValue><![CDATA[Ask OpenAI whether this song is appropriate for the type of event]]></drools:metaValue>
