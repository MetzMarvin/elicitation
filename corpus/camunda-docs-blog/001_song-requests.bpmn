      </bpmn2:extensionElements>
      <bpmn2:text>Ask OpenAI whether this song is appropriate for the type of event</bpmn2:text>
    </bpmn2:textAnnotation>
    <bpmn2:textAnnotation id="TextAnnotation_05lge6g" name="Start an instance with a payload containing `person.name`, `person.email`, and `eventType`">
      <bpmn2:extensionElements>
        <drools:metaData name="elementname">
          <drools:metaValue><![CDATA[Start an instance with a payload containing `person.name`, `person.email`, and `eventType`]]></drools:metaValue>
        </drools:metaData>
      </bpmn2:extensionElements>
      <bpmn2:text>Start an instance with a payload containing `person.name`, `person.email`, and `eventType`</bpmn2:text>
    </bpmn2:textAnnotation>
    <bpmn2:textAnnotation id="TextAnnotation_1atka0c" name="If OpenAI is unsure whether the song is appropriate, use Camunda Forms to display the Song Lyrics and decide to approve or reject">
      <bpmn2:extensionElements>
        <drools:metaData name="elementname">
          <drools:metaValue><![CDATA[If OpenAI is unsure whether the song is appropriate, use Camunda Forms to display the Song Lyrics and decide to approve or reject]]></drools:metaValue>
        </drools:metaData>
      </bpmn2:extensionElements>
      <bpmn2:text>If OpenAI is unsure whether the song is appropriate, use Camunda Forms to display the Song Lyrics and decide to approve or reject</bpmn2:text>
