{
  "$schema": "https://cloud.uipath.com/draft/2024-12/entry-point",
  "$id": "entry-points.json",
  "entryPoints": [
    {
      "filePath": "/content/agent.json",
      "type": "agent",
      "uniqueId": "46888970-7c49-45f1-ae9e-a13370e98bbd",
      "input": {
        "type": "object",
        "properties": {
          "files": {
            "type": "array",
