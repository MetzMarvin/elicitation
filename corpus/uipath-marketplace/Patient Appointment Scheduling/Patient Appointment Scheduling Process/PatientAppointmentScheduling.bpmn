<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:uipath="http://uipath.org/schema/bpmn" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="x-uipath-initial-diagram" targetNamespace="http://www.omg.org/spec/BPMN/20100524/MODEL" exporter="UiPath Studio Web (https://uipath.com)" exporterVersion="f256f8a6">
  <bpmn:process id="Process_1" name="PatientAppointmentScheduling" isExecutable="false">
    <bpmn:extensionElements>
      <uipath:variables version="v1">
        <uipath:inputOutput id="vabMTzOwk" name="sampleOutput" type="string" elementId="Task_OfferAlternatives" canonicalId="sampleOutput" custom="true" />
        <uipath:inputOutput id="v7QU4u66K" name="sampleOutput" type="string" elementId="Task_VerifyEligibility" canonicalId="sampleOutput2" custom="true" />
      </uipath:variables>
      <uipath:migrationVersion version="21" />
      <uipath:intsvcActivityConfig version="v2" />
    </bpmn:extensionElements>
    <bpmn:userTask id="Task_CapturePreferences" name="Capture Patient Preferences">
      <bpmn:incoming>Flow_StartToCapture</bpmn:incoming>
      <bpmn:outgoing>Flow_CaptureToCheck</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="Task_CheckAvailability" name="Check Provider Availability">
      <bpmn:incoming>Flow_CaptureToCheck</bpmn:incoming>
      <bpmn:outgoing>Flow_CheckToGateway</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_SlotAvailable" name="Preferred Slot Available?">
      <bpmn:incoming>Flow_CheckToGateway</bpmn:incoming>
      <bpmn:outgoing>Flow_SlotNotAvailable</bpmn:outgoing>
      <bpmn:outgoing>Flow_SlotAvailable</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_OfferAlternatives" name="Offer Alternatives / Add to Waitlist Agent">
      <bpmn:extensionElements>
        <uipath:tags>
          <uipath:tag key="caseTaskType">agent</uipath:tag>
        </uipath:tags>
        <uipath:activity version="v1">
          <uipath:type value="Orchestrator.StartAgentJob" version="v1" />
          <uipath:output name="sampleOutput" type="string" source="" var="vabMTzOwk" custom="true" />
        </uipath:activity>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_SlotNotAvailable</bpmn:incoming>
      <bpmn:outgoing>Flow_OfferToPatientResponse</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:eventBasedGateway id="Gateway_PatientResponse" name="Patient Response">
      <bpmn:incoming>Flow_OfferToPatientResponse</bpmn:incoming>
      <bpmn:outgoing>Flow_PatientResponseToAccepts</bpmn:outgoing>
      <bpmn:outgoing>Flow_PatientResponseToNoResponse</bpmn:outgoing>
    </bpmn:eventBasedGateway>
    <bpmn:intermediateCatchEvent id="Event_AcceptsAlternative" name="Patient Accepts Alternative">
      <bpmn:incoming>Flow_PatientResponseToAccepts</bpmn:incoming>
      <bpmn:outgoing>Flow_AcceptsToMerge</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="Event_NoResponseTimer" name="No Patient Response">
      <bpmn:incoming>Flow_PatientResponseToNoResponse</bpmn:incoming>
      <bpmn:outgoing>Flow_NoResponseToEnd</bpmn:outgoing>
      <bpmn:timerEventDefinition>
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT72H</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="End_AbandonedNoResponse" name="Request Abandoned: No Response to Alternatives">
      <bpmn:incoming>Flow_NoResponseToEnd</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="Gateway_MergePaths">
      <bpmn:incoming>Flow_SlotAvailable</bpmn:incoming>
      <bpmn:incoming>Flow_AcceptsToMerge</bpmn:incoming>
      <bpmn:outgoing>Flow_MergeToParallelSplit</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:parallelGateway id="Gateway_ParallelSplit" name="Confirm Appointment &#38; Eligibility">
      <bpmn:incoming>Flow_MergeToParallelSplit</bpmn:incoming>
      <bpmn:outgoing>Flow_ParallelSplitToReserve</bpmn:outgoing>
      <bpmn:outgoing>Flow_ParallelSplitToVerify</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:serviceTask id="Task_ReserveSlot" name="Reserve Appointment Slot">
      <bpmn:incoming>Flow_ParallelSplitToReserve</bpmn:incoming>
      <bpmn:outgoing>Flow_ReserveToParallelJoin</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_VerifyEligibility" name="Verify Insurance Eligibility Agent">
      <bpmn:extensionElements>
        <uipath:tags>
          <uipath:tag key="caseTaskType">agent</uipath:tag>
        </uipath:tags>
        <uipath:activity version="v1">
          <uipath:type value="Orchestrator.StartAgentJob" version="v1" />
          <uipath:output name="sampleOutput" type="string" source="" var="v7QU4u66K" custom="true" />
        </uipath:activity>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ParallelSplitToVerify</bpmn:incoming>
      <bpmn:outgoing>Flow_VerifyToParallelJoin</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:boundaryEvent id="Event_EligibilityDelayed" name="Eligibility Check Delayed" cancelActivity="false" attachedToRef="Task_VerifyEligibility">
      <bpmn:outgoing>Flow_EligibilityDelayedToSLA</bpmn:outgoing>
      <bpmn:timerEventDefinition>
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT24H</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:endEvent id="End_SLABreach" name="Escalated: Eligibility SLA Breach">
      <bpmn:incoming>Flow_EligibilityDelayedToSLA</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:parallelGateway id="Gateway_ParallelJoin">
      <bpmn:incoming>Flow_ReserveToParallelJoin</bpmn:incoming>
      <bpmn:incoming>Flow_VerifyToParallelJoin</bpmn:incoming>
      <bpmn:outgoing>Flow_ParallelJoinToEligibilityResult</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:exclusiveGateway id="Gateway_EligibilityResult" name="Eligibility Result">
      <bpmn:incoming>Flow_ParallelJoinToEligibilityResult</bpmn:incoming>
      <bpmn:outgoing>Flow_NotEligible</bpmn:outgoing>
      <bpmn:outgoing>Flow_Eligible</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="End_NotEligible" name="Appointment Cancelled: Insurance Not Eligible">
      <bpmn:incoming>Flow_NotEligible</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="Task_GenerateConfirmation" name="Generate Appointment Confirmation">
      <bpmn:incoming>Flow_Eligible</bpmn:incoming>
      <bpmn:outgoing>Flow_GenerateToConfirm</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sendTask id="Task_SendConfirmation" name="Send Confirmation to Patient">
      <bpmn:incoming>Flow_GenerateToConfirm</bpmn:incoming>
      <bpmn:outgoing>Flow_SendToPatientConfirmation</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:eventBasedGateway id="Gateway_PatientConfirmation" name="Patient Confirmation">
      <bpmn:incoming>Flow_SendToPatientConfirmation</bpmn:incoming>
      <bpmn:outgoing>Flow_PatientConfirmationToConfirms</bpmn:outgoing>
      <bpmn:outgoing>Flow_PatientConfirmationToNoConfirm</bpmn:outgoing>
    </bpmn:eventBasedGateway>
    <bpmn:intermediateCatchEvent id="Event_PatientConfirms" name="Patient Confirms Appointment">
      <bpmn:incoming>Flow_PatientConfirmationToConfirms</bpmn:incoming>
      <bpmn:outgoing>Flow_ConfirmsToSuccess</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="Event_NoConfirmationTimer" name="No Confirmation">
      <bpmn:incoming>Flow_PatientConfirmationToNoConfirm</bpmn:incoming>
      <bpmn:outgoing>Flow_NoConfirmToAbandoned</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="End_AbandonedNoConfirm" name="Request Abandoned: Patient Did Not Confirm">
      <bpmn:incoming>Flow_NoConfirmToAbandoned</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="End_Success" name="Appointment Successfully Scheduled &#38; Confirmed">
      <bpmn:incoming>Flow_ConfirmsToSuccess</bpmn:incoming>
      <bpmn:messageEventDefinition />
    </bpmn:endEvent>
    <bpmn:startEvent id="Event_start" name="Patient Appointment Request Received">
      <bpmn:extensionElements>
        <uipath:entryPointId value="7ba1de83-f93f-462c-bc2e-e5741061dd49" />
      </bpmn:extensionElements>
      <bpmn:outgoing>Flow_StartToCapture</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_StartToCapture" sourceRef="Event_start" targetRef="Task_CapturePreferences" />
    <bpmn:sequenceFlow id="Flow_CaptureToCheck" sourceRef="Task_CapturePreferences" targetRef="Task_CheckAvailability" />
    <bpmn:sequenceFlow id="Flow_CheckToGateway" sourceRef="Task_CheckAvailability" targetRef="Gateway_SlotAvailable" />
    <bpmn:sequenceFlow id="Flow_SlotNotAvailable" name="No" sourceRef="Gateway_SlotAvailable" targetRef="Task_OfferAlternatives">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">="No"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_SlotAvailable" name="Yes" sourceRef="Gateway_SlotAvailable" targetRef="Gateway_MergePaths">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">="Yes"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_OfferToPatientResponse" sourceRef="Task_OfferAlternatives" targetRef="Gateway_PatientResponse" />
    <bpmn:sequenceFlow id="Flow_PatientResponseToAccepts" sourceRef="Gateway_PatientResponse" targetRef="Event_AcceptsAlternative" />
    <bpmn:sequenceFlow id="Flow_PatientResponseToNoResponse" sourceRef="Gateway_PatientResponse" targetRef="Event_NoResponseTimer" />
    <bpmn:sequenceFlow id="Flow_AcceptsToMerge" sourceRef="Event_AcceptsAlternative" targetRef="Gateway_MergePaths" />
    <bpmn:sequenceFlow id="Flow_NoResponseToEnd" sourceRef="Event_NoResponseTimer" targetRef="End_AbandonedNoResponse" />
    <bpmn:sequenceFlow id="Flow_MergeToParallelSplit" sourceRef="Gateway_MergePaths" targetRef="Gateway_ParallelSplit" />
    <bpmn:sequenceFlow id="Flow_ParallelSplitToReserve" sourceRef="Gateway_ParallelSplit" targetRef="Task_ReserveSlot" />
    <bpmn:sequenceFlow id="Flow_ParallelSplitToVerify" sourceRef="Gateway_ParallelSplit" targetRef="Task_VerifyEligibility" />
    <bpmn:sequenceFlow id="Flow_ReserveToParallelJoin" sourceRef="Task_ReserveSlot" targetRef="Gateway_ParallelJoin" />
    <bpmn:sequenceFlow id="Flow_VerifyToParallelJoin" sourceRef="Task_VerifyEligibility" targetRef="Gateway_ParallelJoin" />
    <bpmn:sequenceFlow id="Flow_EligibilityDelayedToSLA" sourceRef="Event_EligibilityDelayed" targetRef="End_SLABreach" />
    <bpmn:sequenceFlow id="Flow_ParallelJoinToEligibilityResult" sourceRef="Gateway_ParallelJoin" targetRef="Gateway_EligibilityResult" />
    <bpmn:sequenceFlow id="Flow_NotEligible" name="Not Eligible" sourceRef="Gateway_EligibilityResult" targetRef="End_NotEligible">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">="Not Eligible"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Eligible" name="Eligible" sourceRef="Gateway_EligibilityResult" targetRef="Task_GenerateConfirmation">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">="Eligible"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_GenerateToConfirm" sourceRef="Task_GenerateConfirmation" targetRef="Task_SendConfirmation" />
    <bpmn:sequenceFlow id="Flow_SendToPatientConfirmation" sourceRef="Task_SendConfirmation" targetRef="Gateway_PatientConfirmation" />
    <bpmn:sequenceFlow id="Flow_PatientConfirmationToConfirms" sourceRef="Gateway_PatientConfirmation" targetRef="Event_PatientConfirms" />
    <bpmn:sequenceFlow id="Flow_PatientConfirmationToNoConfirm" sourceRef="Gateway_PatientConfirmation" targetRef="Event_NoConfirmationTimer" />
    <bpmn:sequenceFlow id="Flow_ConfirmsToSuccess" sourceRef="Event_PatientConfirms" targetRef="End_Success" />
    <bpmn:sequenceFlow id="Flow_NoConfirmToAbandoned" sourceRef="Event_NoConfirmationTimer" targetRef="End_AbandonedNoConfirm" />
  </bpmn:process>
