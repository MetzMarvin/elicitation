        <outputSet id="_265D556C-9176-48DD-AE44-27FB391CC42E" />
      </ioSpecification>
      <script>String aiRec = (String) kcontext.getVariable(&quot;aiRecommendation&quot;);
String dmnDec = (String) kcontext.getVariable(&quot;dmnDecision&quot;);
boolean disagree = (aiRec != null &amp;&amp; dmnDec != null &amp;&amp; !aiRec.equals(dmnDec));
kcontext.setVariable(&quot;requiresHumanReview&quot;, disagree);
if (!disagree) {
    kcontext.setVariable(&quot;finalDecision&quot;, dmnDec);
}</script>
    </scriptTask>
